# Copy to .env.local and fill in real values. Never commit the filled-in file.

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/chesspaa"

# Signing key for better-auth session cookies.
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of the app, used to build OAuth callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
